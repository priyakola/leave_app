        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Only run when status is changing to approved or rejected
    if (!current.status.changes() || 
        (current.status != 'approved' && current.status != 'rejected')) {
        return;
    }
    
    // Check if current user is the assigned approver
    if (current.approver != gs.getUserID()) {
        gs.addErrorMessage('Only the assigned approver can approve or reject this leave request.');
        current.setAbortAction(true);
    }
})(current, previous);]]></script>
