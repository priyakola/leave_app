        <script_true><![CDATA[function onCondition() {
    // Get current user
    var currentUser = g_user.userID;
    
    // Get approver from the form
    var approver = g_form.getValue('approver');
    
    // Hide approval buttons if user is not the approver
    if (currentUser != approver) {
        // Hide approval buttons/fields as appropriate for your form
        g_form.setDisplay('approve_button', false);
        g_form.setDisplay('reject_button', false);
    }
}]]></script_true>
